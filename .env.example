# Copy this file to ".env" and fill in the values.
# Never commit the real ".env" file — it's already in .gitignore.

# ── Order notifications (no Firebase required) ─────────────────────────────
# Shop inbox for new orders
VITE_ORDER_EMAIL=shopwithdee07@gmail.com

# EmailJS — https://www.emailjs.com (free tier is enough to start)
# 1. Create an account and add a Gmail service linked to shopwithdee07@gmail.com
# 2. Create TWO email templates:
#      - template_shop     → sent TO the shop
#      - template_customer → sent TO the customer
# 3. Copy Service ID, Template IDs, and Public Key below
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_SHOP=
VITE_EMAILJS_TEMPLATE_CUSTOMER=
VITE_EMAILJS_PUBLIC_KEY=

# WhatsApp number for orders (international format, no + or spaces)
VITE_WHATSAPP_NUMBER=2349126783004

# ── Optional Firebase (not required for orders) ────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
